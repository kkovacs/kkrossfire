{
  "manifest_version": 3,
  "name": "KKrossfire",
  "version": "0.1.0",
  "description": "Agentic AI side panel that can browse the web for you.",
  "permissions": ["sidePanel", "tabs", "scripting", "storage", "debugger"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open KKrossfire"
  },
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+9",
        "mac": "Command+Shift+9"
      },
      "description": "Toggle KKrossfire"
    },
    "reset": {
      "suggested_key": {
        "default": "Ctrl+Shift+0",
        "mac": "Command+Shift+0"
      },
      "description": "Reset to current tab"
    }
  }
}
